# Copiar a .env en la RAÍZ del repo (junto a docker-compose.yml) y rellenar.
# El .env real no se versiona.
#
# Cómo obtener cada valor:
#   DISCORD_BOT_TOKEN     -> discord.com/developers/applications > tu app > Bot > Reset Token
#   DISCORD_GUILD_ID      -> Ajustes de Discord > Avanzado > Modo desarrollador,
#                            luego clic derecho en el servidor > Copiar ID del servidor
#   DISCORD_CHANNEL_ID    -> clic derecho en el canal del panel > Copiar ID del canal
#   DISCORD_ADMIN_ROLE_ID -> Ajustes del servidor > Roles > clic derecho en el rol > Copiar ID
#
# Invita el bot con los scopes `bot` y `applications.commands`, y permiso para
# enviar mensajes en el canal elegido. No necesita intents privilegiados.

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# El bot habla con el sidecar por loopback; sólo cámbialo si mueves el sidecar.
ZOMBOID_SIDECAR_URL=http://127.0.0.1:61212

# Cada cuánto refresca el panel y detecta entradas/salidas (segundos).
BOT_POLL_INTERVAL_SEC=15

# Cuánto antes del auto-apagado avisa en el canal (segundos).
BOT_WARN_BEFORE_SEC=300
